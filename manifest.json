{
  "manifest_version": 3,
  "name": "KindlePress — Send articles to your Kindle",
  "version": "0.1.1",
  "description": "Turn any web page into a clean EPUB for your Kindle. Unlimited, free, no account, nothing leaves your browser.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads"
  ],
  "action": {
    "default_title": "Send to Kindle",
    "default_popup": "src/popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}